{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["segments"],
  "properties": {
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "spokenFormNotes"],
        "properties": {
          "id": { "type": "string" },
          "spokenFormNotes": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceText", "kind", "explanationZh", "correctedEnglish"],
              "properties": {
                "sourceText": { "type": "string" },
                "kind": { "type": "string", "enum": ["disfluency", "grammar", "mistranscription"] },
                "explanationZh": { "type": "string" },
                "correctedEnglish": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
